// 二分插入位置查找（配合 sortedInsert 的高效版本定位）
fn insertionPoint(xs: [int], v: int): int {
    var lo = 0
    var hi = len(xs)
    while lo < hi {
        let mid = (lo + hi) / 2
        if xs[mid] < v {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return lo
}

fn sortPointRunSelfCheck(): int {
    let xs = [1, 3, 5, 7]
    assert(insertionPoint(xs, 0) == 0, "插入点首")
    assert(insertionPoint(xs, 4) == 2, "插入点中")
    assert(insertionPoint(xs, 9) == 4, "插入点尾")
    return 52
}
