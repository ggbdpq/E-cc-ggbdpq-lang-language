// URL slug：小写、空格转连字符、仅保留字母数字连字符
fn slugify(s: string): string {
    let lower = toUpperAscii(s)
    let lower2 = swapCase(lower)
    var out = ""
    for c in lower2 {
        let code = int(bytes(c)[0])
        let isLower = code >= 97 && code <= 122
        let isDigit = code >= 48 && code <= 57
        if isLower || isDigit {
            out += c
        } else if c == " " {
            out += "-"
        }
    }
    return out
}

fn slugRunSelfCheck(): int {
    assert(slugify("Hello World") == "hello-world", "slug 基础")
    assert(slugify("Lang GO 99") == "lang-go-99", "slug 数字")
    return 48
}
