// 数值算法集：gcd / fib / isPrime / clamp
fn gcd(a: int, b: int): int {
    if b == 0 {
        return a
    }
    return gcd(b, a % b)
}

fn fib(n: int): int {
    if n <= 1 {
        return n
    }
    var a = 0
    var b = 1
    var i = 2
    while i <= n {
        let t = a + b
        a = b
        b = t
        i += 1
    }
    return b
}

fn isPrime(n: int): bool {
    if n < 2 {
        return false
    }
    var d = 2
    while d * d <= n {
        if n % d == 0 {
            return false
        }
        d += 1
    }
    return true
}

fn clamp(v: int, lo: int, hi: int): int {
    if v < lo {
        return lo
    }
    if v > hi {
        return hi
    }
    return v
}

fn mathRunSelfCheck(): int {
    assert(gcd(12, 18) == 6, "gcd")
    assert(fib(10) == 55, "fib")
    assert(isPrime(13) && !isPrime(15), "isPrime")
    assert(clamp(5, 1, 3) == 3, "clamp 上界")
    assert(clamp(0, 1, 3) == 1, "clamp 下界")
    return 4
}
