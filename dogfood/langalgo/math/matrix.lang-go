// 2x2 矩阵：加法 / 数乘 / 乘法 / 行列式
struct Mat2 {
    a: int
    b: int
    c: int
    d: int
}
fn matAdd(x: Mat2, y: Mat2): Mat2 {
    return Mat2{a: x.a + y.a, b: x.b + y.b, c: x.c + y.c, d: x.d + y.d}
}
fn matScale(x: Mat2, k: int): Mat2 {
    return Mat2{a: x.a * k, b: x.b * k, c: x.c * k, d: x.d * k}
}
fn matMul(x: Mat2, y: Mat2): Mat2 {
    return Mat2{
        a: x.a * y.a + x.b * y.c,
        b: x.a * y.b + x.b * y.d,
        c: x.c * y.a + x.d * y.c,
        d: x.c * y.b + x.d * y.d,
    }
}
fn matDet(x: Mat2): int {
    return x.a * x.d - x.b * x.c
}
fn matRunSelfCheck(): int {
    let i = Mat2{a: 1, b: 0, c: 0, d: 1}
    let m = Mat2{a: 2, b: 3, c: 4, d: 5}
    let p = matMul(i, m)
    assert(p.a == 2 && p.d == 5, "单位矩阵乘法")
    assert(matDet(m) == -2, "行列式")
    assert(matAdd(m, m).a == 4, "矩阵加法")
    assert(matScale(m, 3).d == 15, "矩阵数乘")
    return 27
}
