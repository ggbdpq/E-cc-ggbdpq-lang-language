// 扩展数论：lcm（最小公倍数）与同余判断
fn lcm(a: int, b: int): int {
    if a == 0 || b == 0 {
        return 0
    }
    var x = a
    var y = b
    while y != 0 {
        let t = x % y
        x = y
        y = t
    }
    return a * b / x
}

fn sameRemainder(a: int, b: int, m: int): bool {
    if m == 0 {
        return false
    }
    return a % m == b % m
}

fn mathGcdRunSelfCheck(): int {
    assert(lcm(4, 6) == 12, "lcm")
    assert(lcm(0, 5) == 0, "lcm 零")
    assert(sameRemainder(7, 12, 5), "同余")
    assert(!sameRemainder(7, 11, 5), "非同余")
    return 39
}
