// list.ling —— list.go 纯函数层移植（linkpull bilibili）
// probeList 的网络分页循环不在移植范围；此处是清单解析与列表链接决策。

struct Ref {
    url: string
    title: string
}

struct ListTarget {
    mid: string
    kind: string
    sid: string
}

// jsonStr 从动态 JSON 值取字符串字段；缺失或 null 都按 ""（对齐 Go 零值语义）
fn jsonStr(m: any, key: string): string {
    if !has(m, key) {
        return ""
    }
    let v = m[key]
    if isNone(v) {
        return ""
    }
    return v
}

// parseArchives 从列表 API 的 data JSON 提取清单（bvid 为空的跳过）。
// 与 Go 版的差异：非法 JSON 在 ling 是运行时错误（panic），Go 是返回 Err——
// 实际输入来自自家 apiGet，畸形响应不可达，记录于 spec §6.3。
fn parseArchives(s: string): Result[[Ref], error] {
    let v = jsonParse(s)
    var out: [Ref] = []
    if has(v, "archives") {
        let arr = v["archives"]
        for i in 0..len(arr) {
            let a = arr[i]
            let bvid = jsonStr(a, "bvid")
            if bvid == "" {
                continue
            }
            push(out, Ref{url: "https://www.bilibili.com/video/" + bvid, title: jsonStr(a, "title")})
        }
    }
    return Ok(out)
}

// trimSlashes 去首尾斜杠（strings.Trim(path, "/") 的等价子集）
fn trimSlashes(s: string): string {
    var start = 0
    var end = len(s)
    while start < end && s[start] == "/" {
        start = start + 1
    }
    while end > start && s[end - 1] == "/" {
        end = end - 1
    }
    return s[start:end]
}

// splitPath 按 "/" 切路径段
fn splitPath(s: string): [string] {
    var out: [string] = []
    var cur = ""
    for c in s {
        if c == "/" {
            push(out, cur)
            cur = ""
        } else {
            cur = cur + c
        }
    }
    push(out, cur)
    return out
}

// listKindOf 列表链接决策（probeList 头部逻辑原样；入参改为 path + 查询表）
fn listKindOf(path: string, q: map[string]string): Result[ListTarget, error] {
    let segs = splitPath(trimSlashes(path))
    if len(segs) < 2 {
        return Err(err("不是 UP主列表页链接"))
    }
    let mid = segs[0]
    var kind = ""
    var sid = ""
    if segs[1] == "channel" {
        kind = "season"
        sid = jsonStr(q, "sid")
    } else if len(segs) >= 3 && segs[1] == "lists" {
        sid = segs[2]
        kind = jsonStr(q, "type")
        if kind != "series" {
            kind = "season"
        }
    } else {
        return Err(err("不是合集/列表页链接（支持 channel/collectiondetail 与 lists）"))
    }
    if sid == "" || mid == "" {
        return Err(err("列表链接缺少 id 参数"))
    }
    return Ok(ListTarget{mid: mid, kind: kind, sid: sid})
}
