// md5.lang-go —— RFC 1321 纯 lang-go 实现（移植自 linkpull bilibili/md5.go）
//
// lang-go 的 int 是 64 位有符号数，没有 uint32：32 位回绕用「运算后掩码
// 4294967295」表达；所有中间值在掩码纪律下保持非负，移位因此等价于
// 逻辑移位。K 常量表按 RFC 公式（Go 原版 init 现算）由 m4/gofixture
// 生成后固化于此，十进制书写（v0 暂无十六进制字面量）。
let MD5K = [3614090360, 3905402710, 606105819, 3250441966, 4118548399, 1200080426, 2821735955, 4249261313, 1770035416, 2336552879, 4294925233, 2304563134, 1804603682, 4254626195, 2792965006, 1236535329, 4129170786, 3225465664, 643717713, 3921069994, 3593408605, 38016083, 3634488961, 3889429448, 568446438, 3275163606, 4107603335, 1163531501, 2850285829, 4243563512, 1735328473, 2368359562, 4294588738, 2272392833, 1839030562, 4259657740, 2763975236, 1272893353, 4139469664, 3200236656, 681279174, 3936430074, 3572445317, 76029189, 3654602809, 3873151461, 530742520, 3299628645, 4096336452, 1126891415, 2878612391, 4237533241, 1700485571, 2399980690, 4293915773, 2240044497, 1873313359, 4264355552, 2734768916, 1309151649, 4149444226, 3174756917, 718787259, 3951481745]
let MD5SHIFT = [7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21]
let MASK32 = 4294967295

// rotl32 循环左移：x 已按掩码纪律保持 32 位非负
fn rotl32(x: int, n: int): int {
    return (x << n | x >> (32 - n)) & MASK32
}

// md5Sum 返回 16 字节摘要（字节数组，元素为 0..255 的 int）。
// 参数与返回按 [any] 注解：bytes() 产出的数组即此形态，元素运算由
// 转译器在 any 边界收窄为 int。
fn md5Sum(data: [any]): [any] {
    // 消息填充：0x80 + 补零至 56 mod 64 + 64 位小端比特长度
    var padded: [int] = []
    for b in data {
        push(padded, b)
    }
    push(padded, 128)
    while len(padded) % 64 != 56 {
        push(padded, 0)
    }
    let bitLen = len(data) * 8
    for i in 0..8 {
        push(padded, bitLen >> (8 * i) & 255)
    }
    var a0 = 1732584193
    var b0 = 4023233417
    var c0 = 2562383102
    var d0 = 271733878
    var off = 0
    while off < len(padded) {
        var m: [any] = []
        for j in 0..16 {
            push(m, 0)
        }
        for j in 0..16 {
            let i0 = off + 4 * j
            m[j] = padded[i0] | padded[i0 + 1] << 8 | padded[i0 + 2] << 16 | padded[i0 + 3] << 24
        }
        var a = a0
        var b = b0
        var c = c0
        var d = d0
        for i in 0..64 {
            var f = 0
            var g = 0
            if i < 16 {
                f = b & c | (b ^ MASK32) & d
                g = i
            } else if i < 32 {
                f = d & b | (d ^ MASK32) & c
                g = (5 * i + 1) % 16
            } else if i < 48 {
                f = b ^ c ^ d
                g = (3 * i + 5) % 16
            } else {
                f = c ^ (b | (d ^ MASK32))
                g = 7 * i % 16
            }
            f = (f + a + MD5K[i] + m[g]) & MASK32
            // a, d, c = d, c, b 后 b += rotl(f)（Go 原版的多重赋值展开）
            let nb = (b + rotl32(f, MD5SHIFT[i])) & MASK32
            a = d
            d = c
            c = b
            b = nb
        }
        a0 = (a0 + a) & MASK32
        b0 = (b0 + b) & MASK32
        c0 = (c0 + c) & MASK32
        d0 = (d0 + d) & MASK32
        off = off + 64
    }
    var digest: [any] = []
    for v in [a0, b0, c0, d0] {
        push(digest, v & 255)
        push(digest, v >> 8 & 255)
        push(digest, v >> 16 & 255)
        push(digest, v >> 24 & 255)
    }
    return digest
}

// md5Hex 十六进制小写摘要
fn md5Hex(s: string): string {
    let d = md5Sum(bytes(s))
    let hexDigits = "0123456789abcdef"
    var out = ""
    for v in d {
        out = out + hexDigits[v >> 4] + hexDigits[v & 15]
    }
    return out
}
