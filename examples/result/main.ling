// result —— Result/? 链式错误处理（对照 Go 的 if err != nil）
// 预载：enum Result[T, E] { Ok(T)  Err(E) }   struct error { msg: string }
fn parseAge(s: string): Result[int, error] {
    if len(s) == 0 {
        return Err(err("空输入"))
    }
    if s == "0" {
        return Err(err("年龄不能为 0"))
    }
    return Ok(int(s))
}
fn check(s: string): Result[string, error] {
    // ? 把 Err 原样上抛，Ok 解包——一行顶 Go 的三行
    let age = parseAge(s)?
    if age > 150 {
        return Err(err("年龄离谱: " + s))
    }
    return Ok("年龄 " + str(age) + " 已登记")
}
fn show(s: string) {
    match check(s) {
        Ok(msg) => println("√", msg)
        Err(e) => println("×", e.msg)
    }
}
fn main() {
    show("28")
    show("0")
    show("")
    show("200")
}
