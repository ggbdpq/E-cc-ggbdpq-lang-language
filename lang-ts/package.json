{
  "name": "lang-go-ts",
  "version": "0.6.0",
  "description": "lang-go 语言的 TypeScript 独立实现（解释器 / →Go / →JS 三路执行 + 契约层 + CLI）",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "lang-go-ts": "./dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "conformance": "node dist/cli/main.js conformance ../../conformance",
    "cli": "node dist/cli/main.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
